-- ---------------------------------------------------------------------------
-- Handlers iRite
-- ---------------------------------------------------------------------------

handler WidgetClicked;
    iWidget : integer;
begin
    iWidget := EventWidget;

    if iWidget = lbWtarge then
        g_iPendingEntry := EntryTargetWeight;
        entryPrompt(numType, "Peso objetivo kg");
    elsif iWidget = btStart then
        StartFilling;
    end if;
end;

handler UserEntry;
    sEntry : string;
    rEntry : real;
begin
    sEntry := GetEntry;

    if g_iPendingEntry = EntryTargetWeight then
        if sEntry <> "" then
            rEntry := StringToReal(sEntry);
            if rEntry < 0.0 then
                rEntry := 0.0;
            end if;
            if rEntry > 999.0 then
                rEntry := 999.0;
            end if;
            g_rTargetWeight := rEntry;
        end if;
    end if;

    g_iPendingEntry := EntryNone;
    RefreshScreen;
end;

--handler Timer1Trip;
--begin
--    CheckTarget;
--end;

-- Cree aca el nuevo handler para el setpoint 1 y mande a llamar StopFilling("COMPLETADO"); dentro del Handler

handler SP1Trip;
begin
    StopFilling("COMPLETADO");
end;
-- ---------------------------------------------------------------------------
-- Startup handlerStartup
-- ---------------------------------------------------------------------------

begin
    g_rTargetWeight := 50.0;
    g_rCurrentWeight := 0.0;
    g_iFilling := 0;
    g_iOutputState := 0;
    g_iPendingEntry := EntryNone;
    g_sState := "ESPERANDO";

    SelectScreen(1);
    SetFillOutput(0);
    RefreshScreen;

    --SetTimerMode(g_ciTimerMonitor, TimerContinuous);
    -- Inicializacion de timer
    --SetTimer(g_ciTimerMonitor, g_ciMonitorMs);
    --StartTimer(g_ciTimerMonitor);
    -- Inicializacion de setpoint.

    -- Ingrese aca la funcion set del setpoint 1 con el valor del peso objetivo g_rTargetWeight
    SetSPValue(1, g_rTargetWeight);
    -- Ingrese aca la funcion enable del setpoint 1
    EnableSP(1);
end main;
