program main;
#include main.iri
-- IPESA Ensacado - Prueba tecnica iRite para Rice Lake 1280.
-- Monolito intencional: una pantalla Revolution ya configurada y un solo SRC.
-- El archivo usa sintaxis iRite validada contra Context7 /fr4nkastro/frank-docs:
-- declaraciones antes de uso, procedimientos/handlers con begin/end, := para
-- asignacion, = para comparacion, y handlers WidgetClicked/UserEntry/Timer1Trip.

-- ---------------------------------------------------------------------------
-- Configuracion basica
-- ---------------------------------------------------------------------------

g_ciScale1        : constant integer := 1;
g_ciFillSlot      : constant integer := 0;
g_ciFillOutput    : constant integer := 1;
g_ciTimerMonitor  : constant integer := 1;
g_ciMonitorMs     : constant integer := 25;

type Entry is (
    EntryNone,
    EntryTargetWeight
);
type DataType is (strType, numType, passType);

g_rTargetWeight   : real;
g_rCurrentWeight  : real;
g_iFilling        : integer;
g_iOutputState    : integer;
g_iPendingEntry   : Entry;
g_sState          : string;

-- ---------------------------------------------------------------------------
-- Utilidades
-- ---------------------------------------------------------------------------

procedure entryPrompt(dataType: DataType; message: string);
begin
    ClosePrompt;
    if dataType = strType then    
        PromptUser(message);
    elsif dataType= numType then
        PromptNumeric(message);
    elsif dataType = passType then
        PromptPassword(message);
    end if;
end;

function ReadGrossWeight : real;
    sysError : SysCode;
    rWeight  : real;
begin
    rWeight := g_rCurrentWeight;
    sysError := GetGross(g_ciScale1, Primary, rWeight);
    if sysError <> SysOk then
        DisplayStatus("Error GetGross");
    end if;
    return rWeight;
end;

procedure RefreshScreen;
begin
    SetLabelText(lbWtarge, RealToString(g_rTargetWeight, 0, 2) + " kg");
    SetLabelText(lbState, g_sState);

    if g_iOutputState = 1 then
        SetLabelText(lbOutput, "ON");
    else
        SetLabelText(lbOutput, "OFF");
    end if;
end;

procedure SetFillOutput(iValue : integer);
    sysError : SysCode;
begin
    sysError := SetDigout(g_ciFillSlot, g_ciFillOutput, iValue);
    if sysError <> SysOk then
        DisplayStatus("Error SetDigout");
    end if;
    RefreshScreen;
end;

procedure StopFilling(sReason : string);
begin
    g_iFilling := 0;
    g_sState := sReason;
    SetFillOutput(0);
end;

procedure StartFilling;
begin
    if g_rTargetWeight <= 0.0 then
        g_sState := "SETEA PESO";
        RefreshScreen;
        return;
    end if;

    g_iFilling := 1;
    g_sState := "LLENANDO";
    SetFillOutput(1);
end;

--procedure CheckTarget;
--begin
